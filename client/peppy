#!/usr/bin/env python3
"""peppy - call InDesign through the Peppy plug-in (plain JSON-RPC).

  peppy app.info
  peppy commands                          # every command
  peppy frame.text x=36 y=36 width=300 height=80 contents='Hello'
  peppy item.transform '{"ids": [231], "rotate": 15}'
  peppy --batch calls.json                # [{"method":..,"params":..}, ...] as one undo step

Reads the URL and token from ~/Library/Application Support/Peppy/session.json
(PEPPY_HOME overrides the folder). key=value values are JSON when they parse.
"""

import json
import os
import sys
import urllib.request

TEXT_KEYS = {"name", "contents", "path", "page", "find", "replace", "layer", "parent", "code"}


def session():
    folder = os.environ.get("PEPPY_HOME") or os.path.expanduser("~/Library/Application Support/Peppy")
    try:
        return json.load(open(os.path.join(folder, "session.json")))
    except FileNotFoundError:
        sys.exit("peppy: InDesign isn't running Peppy (no session.json)")


def send(body):
    req = urllib.request.Request(session()["rpc"], data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.loads(r.read())


def parse(args):
    if len(args) == 1 and args[0].lstrip().startswith("{"):
        return json.loads(args[0])
    params = {}
    for a in args:
        k, _, v = a.partition("=")
        if k in TEXT_KEYS:
            params[k] = v
            continue
        try:
            params[k] = json.loads(v)
        except json.JSONDecodeError:
            params[k] = v
    return params


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "commands":
        for c in send({"jsonrpc": "2.0", "id": 1, "method": "commands.list"})["result"]:
            print(f"{c['method']:<20} {c['description']}")
        return 0
    if argv[0] == "--batch":
        calls = [dict(c, jsonrpc="2.0", id=i) for i, c in enumerate(json.load(open(argv[1])))]
        out = send(calls)
        print(json.dumps(out, indent=2))
        return 1 if any("error" in r for r in out) else 0
    r = send({"jsonrpc": "2.0", "id": 1, "method": argv[0], "params": parse(argv[1:])})
    if "error" in r:
        e = r["error"]
        print(f"peppy: {e['message']}" + (f"\n  hint: {e['data']['hint']}" if e.get("data", {}).get("hint") else ""), file=sys.stderr)
        return 1
    print(json.dumps(r["result"], indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
