resource PluginVersion (kSDKDefPluginVersionResourceID)
{
	kTargetVersion,
	kPpyPluginID,
	kSDKDefPlugInMajorVersionNumber, kSDKDefPlugInMinorVersionNumber,
	kSDKDefHostMajorVersionNumber, kSDKDefHostMinorVersionNumber,
	kPpyCurrentMajorFormatNumber, kPpyCurrentMinorFormatNumber,
	{ kInDesignProduct },
	{ kWildFS },
	kUIPlugIn,
	kPpyVersion
};

resource ClassDescriptionTable(kSDKDefClassDescriptionTableResourceID)
{{{
	// Starts the server and the panel once InDesign is up; stops them on quit.
	Class
	{
		kPpyStartupShutdownBoss,
		kInvalidClass,
		{
			IID_ISTARTUPSHUTDOWN, kPpyStartupShutdownImpl,
			IID_IK2SERVICEPROVIDER, kLazyStartupShutdownProviderImpl,
		}
	},

	// Runs agents' calls on the main thread.
	AddIn
	{
		kSessionBoss,
		kInvalidClass,
		{
			IID_IPPYIDLETASK, kPpyIdleTaskImpl,
		}
	},

	// Window > Peppy
	Class
	{
		kPpyActionComponentBoss,
		kBaseActionComponentBoss,
		{
			IID_IACTIONCOMPONENT, kPpyActionComponentImpl,
		}
	},
}}};

