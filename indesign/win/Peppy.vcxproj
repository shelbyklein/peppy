<?xml version="1.0" encoding="utf-8"?>
<!-- Peppy for InDesign on Windows. build.ps1 copies this into the SDK's
     build\win\prj folder (the SDK's property sheets use paths relative to it)
     and passes PeppyRoot, the repo. Modeled on the SDK's BasicMenu sample. -->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>Peppy</ProjectName>
    <ProjectGuid>{6F1C9A42-3B7E-4C5D-9E21-7A0B5D8C1E33}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="PropertySheets">
    <Import Project="ReleaseX64.sdk.props" />
  </ImportGroup>
  <PropertyGroup>
    <PeppyGen>$(PeppyRoot)\build\win</PeppyGen>
    <OutDir>..\releasex64\peppy\</OutDir>
    <IntDir>.\..\objRx64\Peppy\</IntDir>
    <TargetName>Peppy</TargetName>
    <TargetExt>.pln</TargetExt>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <AdditionalOptions>/vmg @SDKCPPOptions.rsp %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(PeppyRoot)\indesign;$(PeppyGen);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_SECURE_NO_DEPRECATE;_CRT_SECURE_NO_WARNINGS;STRICT;NDEBUG;PEPPY_VERSION="$(PeppyVersion)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <StringPooling>true</StringPooling>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>VCPlugInHeaders.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)Peppy.pch</PrecompiledHeaderOutputFile>
      <ObjectFileName>$(IntDir)%(Filename).obj</ObjectFileName>
      <TreatWarningAsError>false</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>_CRT_SECURE_NO_DEPRECATE;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(PeppyRoot)\indesign;$(PeppyGen);..\..\..\source\sdksamples\common;..\..\..\source\precomp\msvc;..\..\..\source\precomp\common;..\..\..\source\public\includes;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <Culture>0x0409</Culture>
    </ResourceCompile>
    <PreLinkEvent>
      <Command>merge_res.cmd "$(IntDir)" Peppy Ppy &amp; del /f /s "$(TargetDir)($(TargetName) Resources)\"*.idrc &gt; "$(IntDir)prevDeletedResources.txt" 2&gt;&amp;1 &amp; xcopy /Q /E "$(IntDir)"*.idrc "$(TargetDir)($(TargetName) Resources)\" /Y</Command>
    </PreLinkEvent>
    <Link>
      <AdditionalDependencies>$(UI_PLUGIN_LINKLIST);ws2_32.lib;windowscodecs.lib;ole32.lib;user32.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
      <ProgramDatabaseFile>$(OutDir)Peppy.pdb</ProgramDatabaseFile>
      <ImportLibrary>$(IntDir)Peppy.lib</ImportLibrary>
    </Link>
    <PostBuildEvent>
      <Command>restore_res.cmd "$(IntDir)" Peppy Ppy</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- The plug-in's SDK side, on the SDK's precompiled header. -->
    <ClCompile Include="$(PeppyRoot)\indesign\PpyID.cpp" />
    <ClCompile Include="$(PeppyRoot)\indesign\PpyNoStrip.cpp" />
    <ClCompile Include="$(PeppyRoot)\indesign\PpyPlugin.cpp" />
    <ClCompile Include="$(PeppyRoot)\indesign\PpyCommands.cpp" />
    <ClCompile Include="$(PeppyRoot)\indesign\PpyScript.cpp" />
    <ClCompile Include="$(id_sdk_dir)\source\public\libs\publiclib\statics\PlugInStatics.cpp" />
    <ClCompile Include="..\..\..\source\sdksamples\common\SDKPlugInEntrypoint.cpp" />
    <ClCompile Include="$(PeppyRoot)\indesign\win\TriggerResourceDeps.cpp" />
    <ClCompile Include="$(id_sdk_dir)\source\precomp\msvc\VCPlugInHeaders.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <!-- Peppy's own code: no SDK, no precompiled header. -->
    <ClCompile Include="$(PeppyRoot)\shared\Core.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\shared\Dispatch.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\shared\Narrate.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\shared\Mcp.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\shared\Server.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\shared\Catalog.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\shared\Paths.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\indesign\win\PpyImageWin.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
    <ClCompile Include="$(PeppyRoot)\indesign\win\PpyPanelWin.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <CustomBuild Include="$(PeppyRoot)\indesign\Ppy.fr">
      <Command>odfrc $(ODFRC_ADDITIONAL_FLAGS) "%(FullPath)" -o "$(IntDir)%(Filename).fres" -i "$(PeppyRoot)\indesign" -i "$(PeppyGen)" @SDKODFRCOptions.rsp
</Command>
      <AdditionalInputs>$(IntDir)TriggerResourceDeps.obj;$(PeppyRoot)\indesign\PpyID.h;$(PeppyRoot)\indesign\PpyFactoryList.h;$(PeppyGen)\PpyVersion.h;%(AdditionalInputs)</AdditionalInputs>
      <Outputs>$(IntDir)%(Filename).fres;%(Outputs)</Outputs>
    </CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="$(PeppyRoot)\indesign\win\Peppy.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
